<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="sysmon,lab,">
        <rule id="100100" level="3">
                <if_sid>61603</if_sid>
                <description>LAB scaffolding: Sysmon Event 1 process creation - $(win.eventdata.image)</description>
        </rule>
</group>

<!-- Detection rules under test. One block of 10 rule_ids per technique, matrix order
     (design-spec.md §5). Each rule is authored from its Sigma source (rules/sigma/)
     and validated with wazuh-logtest before use. See its ADS in docs/templates/. -->
<group name="sysmon,lab,attack,">
  <!-- T1059.001 PowerShell - encoded command line. Source: rules/sigma/T1059.001_powershell_encoded_command.yml
       ADS: docs/templates/ads-T1059.001-example.md -->
  <rule id="100200" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-e(nc|ncodedcommand)?(\s|$)</field>
    <description>T1059.001: PowerShell launched with an encoded command - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>
</group>