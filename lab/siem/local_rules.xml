<!-- Location: /var/ossec/etc/rules/local_rules.xml -->
<!-- Wazuh Version: 4.14.7 -->

<group name="sysmon,lab,attack,">
  <!-- Rule 100001 - PowerShell Encoded Command Execution -->
  <!-- MITRE ATT&CK: T1059.001 - Command and Scripting Interpreter: PowerShell -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Converted from rules/sigma/T1059.001_powershell_encoded_command.yml with sigma_to_wazuh (raw output in rules/wazuh/), then 3 manual fixes (see ADS). -->
  <rule id="100001" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:\ \-enc\ |\ \-encodedcommand\b|\ \-e\ )</field>
    <description>T1059.001: PowerShell launched with an encoded command - $(win.eventdata.commandLine) (Sigma rule by frack113)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Rule 100002 - Scheduled task created with schtasks.exe -->
  <!-- MITRE ATT&CK: T1053.005 - Scheduled Task/Job: Scheduled Task -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Hand written from rules/sigma/T1053.005_schtasks_creation.yml. sigma_to_wazuh skipped it (unsupported "1 of" condition, see ADS). -->
  <rule id="100002" level="6">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\ /create\ </field>
    <field name="win.eventdata.user" type="pcre2" negate="yes">(?i)AUTHORI|AUTORI</field>
    <description>T1053.005: Scheduled task created with schtasks.exe - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Rule 100003 - Registry Run key persistence -->
  <!-- MITRE ATT&CK: T1547.001 - Boot or Logon Autostart Execution: Registry Run Keys -->
  <!-- Sysmon Event ID 13 - Registry Value Set -->
  <rule id="100003" level="10">
    <if_sid>92300</if_sid>
    <description>T1547.001: Registry Run key persistence - $(win.eventdata.targetObject)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- Rule 100005 - Windows service created with sc.exe -->
  <!-- MITRE ATT&CK: T1543.003 - Create or Modify System Process: Windows Service -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Converted from rules/sigma/T1543.003_sc_create_service.yml with sigma_to_wazuh (raw output in rules/wazuh/), then manual fixes (see ADS). -->
  <rule id="100005" level="6">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\sc\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^(?=.*create)(?=.*binpath)</field>
    <description>T1543.003: Windows service created with sc.exe - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
  </rule>
</group>