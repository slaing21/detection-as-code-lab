<!-- Location: /var/ossec/etc/rules/local_rules.xml -->
<!-- Wazuh Version: 4.14.7 -->

<group name="sysmon,lab,attack,">
  <!-- Rule 100001 - PowerShell Encoded Command Execution -->
  <!-- MITRE ATT&CK: T1059.001 - Command and Scripting Interpreter: PowerShell -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Converted from rules/sigma/T1059.001_powershell_encoded_command.yml with sigma_to_wazuh (raw output in rules/wazuh/), then 3 manual fixes (see ADS). -->
  <rule id="100001" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:\ \-enc\ |\ \-encodedcommand\b|\ \-e\ )</field>
    <description>T1059.001: PowerShell launched with an encoded command - $(win.eventdata.commandLine) (Sigma rule by frack113)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Rule 100002 - Scheduled task created with schtasks.exe -->
  <!-- MITRE ATT&CK: T1053.005 - Scheduled Task/Job: Scheduled Task -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Hand written from rules/sigma/T1053.005_schtasks_creation.yml. sigma_to_wazuh skipped it (unsupported "1 of" condition, see ADS). -->
  <rule id="100002" level="6">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\ /create\ </field>
    <field name="win.eventdata.user" type="pcre2" negate="yes">(?i)AUTHORI|AUTORI</field>
    <description>T1053.005: Scheduled task created with schtasks.exe - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Rule 100003 - Registry Run key persistence -->
  <!-- MITRE ATT&CK: T1547.001 - Boot or Logon Autostart Execution: Registry Run Keys -->
  <!-- Sysmon Event ID 13 - Registry Value Set -->
  <!-- tuning_pass 1: chained on 61615 (logtest/json path) and 92300 (production/eventchannel path), explicit Run-key match, negate value data in trusted dirs to drop benign autostart FPs (see ADS). -->
  <rule id="100003" level="10">
    <if_sid>61615,92300</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+CurrentVersion\\+Run</field>
    <field name="win.eventdata.details" type="pcre2" negate="yes">(?i)\\+(System32|SysWOW64|Program Files)\\+</field>
    <description>T1547.001: Registry Run key persistence - $(win.eventdata.targetObject) -> $(win.eventdata.details)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- Rule 100004 - WMI event subscription created (filter, consumer, or binding) -->
  <!-- MITRE ATT&CK: T1546.003 - Event Triggered Execution: Windows Management Instrumentation Event Subscription -->
  <!-- Sysmon Event ID 19, 20, 21 - WmiEvent -->
  <!-- Converted from rules/sigma/T1546.003 with sigma_to_wazuh (raw output in rules/wazuh/), then manual fixes (see ADS). -->
  <rule id="100004" level="8">
    <if_sid>61647, 61648, 61649</if_sid>
    <description>T1546.003: WMI event subscription $(win.eventdata.eventType) $(win.eventdata.operation)</description>
    <mitre>
      <id>T1546.003</id>
    </mitre>
  </rule>

  <!-- Rule 100005 - Windows service created with sc.exe -->
  <!-- MITRE ATT&CK: T1543.003 - Create or Modify System Process: Windows Service -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- tuning_pass 1: negate binPath into System32/SysWOW64/Program Files to drop benign service FPs. ["\\]* absorbs the escaped quote and doubled backslashes the eventchannel decoder emits (logtest's json decoder does not, see ADS). -->
  <rule id="100005" level="6">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\sc\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^(?=.*create)(?=.*binpath)</field>
    <field name="win.eventdata.commandLine" type="pcre2" negate="yes">(?i)binpath=\s*["\\]*[a-z]:\\+(Windows\\+System32|Windows\\+SysWOW64|Program Files)</field>
    <description>T1543.003: Windows service created with sc.exe - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
  </rule>

  <!-- Rule 100006 - Child process spawned by fodhelper.exe (UAC bypass) -->
  <!-- MITRE ATT&CK: T1548.002 - Abuse Elevation Control Mechanism: Bypass User Account Control -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Converted from rules/sigma/T1548.002_uac_bypass_fodhelper.yml with sigma_to_wazuh (raw output in rules/wazuh/), then manual fixes (see ADS). -->
  <rule id="100006" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\fodhelper\.exe$</field>
    <description>T1548.002: Child process spawned by fodhelper.exe (possible UAC bypass) - $(win.eventdata.image)</description>
    <mitre>
      <id>T1548.002</id>
    </mitre>
  </rule>

  <!-- Rule 100007 - Renamed system utility (OriginalFileName vs Image mismatch) -->
  <!-- MITRE ATT&CK: T1036.003 - Masquerading: Rename System Utilities -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Converted from rules/sigma/T1036.003_renamed_binary.yml with sigma_to_wazuh (raw output in rules/wazuh/), then manual fixes (see ADS). -->
  <rule id="100007" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^(Cmd\.Exe|CONHOST\.EXE|7z\.exe|7za\.exe|7zr\.exe|WinRAR\.exe|wevtutil\.exe|net\.exe|net1\.exe|netsh\.exe|InstallUtil\.exe)$</field>
    <field name="win.eventdata.image" type="pcre2" negate="yes">(?i)\\(cmd|conhost|7z|7za|7zr|winrar|wevtutil|net|net1|netsh|installutil)\.exe$</field>
    <description>T1036.003: Renamed system utility - OriginalFileName $(win.eventdata.originalFileName) running as $(win.eventdata.image)</description>
    <mitre>
      <id>T1036.003</id>
    </mitre>
  </rule>

  <!-- Rule 100008 - Regsvr32 COM scriptlet execution (scrobj.dll image load) -->
  <!-- MITRE ATT&CK: T1218.010 - System Binary Proxy Execution: Regsvr32 -->
  <!-- Sysmon Event ID 7 - Image Loaded -->
  <!-- Converted from rules/sigma/T1218.010_regsvr32_scrobj.yml with sigma_to_wazuh, then manual fixes (see ADS). -->
  <rule id="100008" level="8">
    <if_sid>61609</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\regsvr32\.exe$</field>
    <field name="win.eventdata.imageLoaded" type="pcre2">(?i)\\scrobj\.dll$</field>
    <description>T1218.010: Regsvr32 COM scriptlet execution - $(win.eventdata.image) loaded $(win.eventdata.imageLoaded)</description>
    <mitre>
      <id>T1218.010</id>
    </mitre>
  </rule>

  <!-- Rule 100009 - UAC remote restrictions disabled (LocalAccountTokenFilterPolicy = 1) -->
  <!-- MITRE ATT&CK: T1112 - Modify Registry -->
  <!-- Sysmon Event ID 13 - Registry value set -->
  <!-- Converted from rules/sigma/T1112_localaccounttokenfilterpolicy.yml with sigma_to_wazuh, then manual fixes (see ADS). -->
  <rule id="100009" level="8">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)LocalAccountTokenFilterPolicy$</field>
    <field name="win.eventdata.details" type="pcre2">(?i)\(0x0*1\)$</field>
    <description>T1112: UAC remote restrictions disabled - LocalAccountTokenFilterPolicy set to $(win.eventdata.details)</description>
    <mitre>
      <id>T1112</id>
    </mitre>
  </rule>

  <!-- Rule 100010 - Local account/group enumeration via net.exe/net1.exe -->
  <!-- MITRE ATT&CK: T1087.001 - Account Discovery: Local Account -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Hand written from rules/sigma/T1087.001_net_account_discovery.yml. (sigma_to_wazuh skips multi-selection conditions). -->
  <rule id="100010" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(user|localgroup)</field>
    <description>T1087.001: Local account enumeration - $(win.eventdata.image) $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
  </rule>

  <!-- Rule 100011 - System information discovery with systeminfo.exe -->
  <!-- MITRE ATT&CK: T1082 - System Information Discovery -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Converted from rules/sigma/T1082_systeminfo_execution.yml with sigma_to_wazuh (raw output in rules/wazuh/), then manual fixes (see ADS). -->
  <rule id="100011" level="6">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^sysinfo\.exe$</field>
    <description>T1082: System information discovery with systeminfo.exe - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1082</id>
    </mitre>
  </rule>

  <!-- Rule 100012 - Admin share mapping via net use (net.exe/net1.exe) -->
  <!-- MITRE ATT&CK: T1021.002 - Remote Services: SMB/Windows Admin Shares -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Hand written from rules/sigma/T1021.002_net_use_admin_share.yml (sigma_to_wazuh skips multi-selection conditions). -->
  <rule id="100012" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\buse\b</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(C|ADMIN|IPC)\$</field>
    <description>T1021.002: Admin share mapping - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

  <!-- Rule 100013 - Certutil URL download (urlcache) -->
  <!-- MITRE ATT&CK: T1105 - Ingress Tool Transfer -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Hand written from rules/sigma/T1105_certutil_urlcache.yml (sigma_to_wazuh skips multi-selection conditions). -->
  <rule id="100013" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^certutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)urlcache</field>
    <description>T1105: Certutil URL download - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- Rule 100014 - PowerShell Compress-Archive data archiving -->
  <!-- MITRE ATT&CK: T1560 - Archive Collected Data -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Hand written from rules/sigma/T1560_powershell_compress_archive.yml (sigma_to_wazuh skips multi-selection conditions). -->
  <rule id="100014" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^PowerShell\.EXE$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)Compress-Archive</field>
    <description>T1560: PowerShell data archiving - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1560</id>
    </mitre>
  </rule>

  <!-- Rule 100015 - Volume shadow copy deletion via vssadmin -->
  <!-- MITRE ATT&CK: T1490 - Inhibit System Recovery -->
  <!-- Sysmon Event ID 1 - Process Creation -->
  <!-- Converted from rules/sigma/T1490_vssadmin_delete_shadows.yml, then manual fixes (see ADS). -->
  <rule id="100015" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^VSSADMIN\.EXE$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)delete\s+shadows</field>
    <description>T1490: Volume shadow copy deletion - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>
</group>